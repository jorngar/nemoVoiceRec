# Copy to .env.local (untracked) for machine-specific settings.
# Read by scripts/package.mjs and scripts/setup-runtime.sh.

# Where electron-builder downloads Electron and its tools (default: your user cache).
# ELECTRON_CACHE=/path/to/cache/electron
# ELECTRON_BUILDER_CACHE=/path/to/cache/electron-builder

# npm download cache.
# npm_config_cache=/path/to/cache/npm
